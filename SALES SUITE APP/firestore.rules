rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return signedIn() && myProfile().role == 'admin';
    }

    function inCompany(companyId) {
      return signedIn() && myProfile().companyId == companyId;
    }

    function hasCompanyAccess(companyId) {
      return isAdmin() || inCompany(companyId);
    }

    // Each person's own profile: which company they belong to, and their role.
    // Not self-writable — an admin assigns these by hand in the console (see SETUP.md),
    // so a member can never grant themselves another company or admin rights.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /companies/{companyId} {
      allow read, write: if hasCompanyAccess(companyId);

      match /quotations/{quoteId} {
        allow read, write: if hasCompanyAccess(companyId);
      }

      match /acknowledgements/{oaId} {
        allow read, write: if hasCompanyAccess(companyId);
      }

      // Purchase orders — company-scoped like quotations/acknowledgements, since each
      // company carries its own financial obligations to suppliers and its own record
      // of what its customers ordered.
      match /purchaseOrders/{poId} {
        allow read, write: if hasCompanyAccess(companyId);
      }

      match /customerPurchaseOrders/{cpoId} {
        allow read, write: if hasCompanyAccess(companyId);
      }
    }

    // Product catalog is shared across all three companies — the same items get
    // sold under more than one company, so keeping separate lists would just mean
    // re-entering the same product three times.
    match /catalog/{itemId} {
      allow read, write: if signedIn();
    }

    // Customer directory is shared across all three companies too — the same
    // customer often buys from more than one, so contact details are entered once.
    match /customers/{customerId} {
      allow read, write: if signedIn();
    }

    // Supplier directory is shared for the same reason the catalog and customer
    // directories are — the same supplier can serve more than one company.
    match /suppliers/{supplierId} {
      allow read, write: if signedIn();

      match /items/{itemId} {
        allow read, write: if signedIn();
      }
    }
  }
}
