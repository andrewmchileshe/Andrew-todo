# SMTP credentials for the RFQ auto-response email.
# Recommended: use the Hostinger-hosted mailbox for sales@labmallscientific.com
# (Hostinger webmail > Email Accounts > Connect Apps / SMTP settings) or another
# transactional provider (e.g. Resend, SendGrid SMTP relay).

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sales@labmallscientific.com
SMTP_PASS=

# Optional overrides
SMTP_FROM="Labmall Scientific Website <sales@labmallscientific.com>"
RFQ_TO_EMAIL=sales@labmallscientific.com
